PM_MODEL_ROOT=models
PM_ALLOWED_HOSTS=["localhost","127.0.0.1"]
PM_CORS_ORIGINS=[]
PM_AUTH_MODE=local
# Set bearer mode and a random secret of at least 24 characters before network exposure.
# PM_API_TOKEN=replace-with-a-long-random-secret
PM_MAX_BODY_BYTES=1048576
PM_MAX_HISTORY_ROWS=1000
PM_INFERENCE_CAPACITY=2
PM_REQUEST_TIMEOUT_SECONDS=120
PM_BODY_TIMEOUT_SECONDS=15
PM_SHUTDOWN_TIMEOUT_SECONDS=130
PM_LOG_LEVEL=INFO
PM_STREAM_DB=data/runtime/stream.sqlite3
PM_STREAM_MAX_PENDING=5000
PM_STREAM_STALE_SECONDS=30
TF_NUM_INTRAOP_THREADS=1
TF_NUM_INTEROP_THREADS=1
OMP_NUM_THREADS=1
# Step 9: historical dashboard (no replay starts automatically)
PM_DASH_HOST=127.0.0.1
PM_DASH_PORT=8050
PM_DASH_API_URL=http://127.0.0.1:8000
PM_DASH_AUTH_MODE=local
PM_DASH_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Optional dashboard login; required for non-loopback binding.
# PM_DASH_AUTH_MODE=basic
# PM_DASH_USERNAME=operator
# PM_DASH_PASSWORD=replace-with-a-random-password-at-least-12-characters
# PM_DASH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# PM_DASH_SECURE_COOKIE=true  # Enable when served through HTTPS.
