    1: import logging
    1: from fastapi.exceptions import RequestValidationError
    1: from starlette.exceptions import HTTPException
    1: from starlette.responses import JSONResponse
       
       
    2: class ServiceError(Exception):
    1:     def __init__(self, status, code, message, details=None):
    8:         self.status, self.code, self.message = status, code, message
    8:         self.details = details or []
       
       
    1: def error_response(request_id, status, code, message, details=None, headers=None):
   34:     return JSONResponse(status_code=status, headers={"X-Request-ID": request_id, **(headers or {})},
   17:                         content={"error_code": code, "message": message, "details": details or [], "request_id": request_id})
       
       
    1: def register_handlers(app):
   20:     @app.exception_handler(ServiceError)
   20:     async def service_error(request, exc):
    5:         request.state.error_code = exc.code
    5:         return error_response(request.state.request_id, exc.status, exc.code, exc.message, exc.details)
       
   20:     @app.exception_handler(RequestValidationError)
   20:     async def validation_error(request, exc):
    2:         request.state.error_code = "INVALID_REQUEST"
               # Do not echo rejected bodies, parser context, tokens or user values.
    8:         details = [{"location": list(e["loc"]), "type": e["type"]} for e in exc.errors()[:20]]
    2:         return error_response(request.state.request_id, 422, "INVALID_REQUEST", "Request does not match the endpoint contract.", details)
       
   20:     @app.exception_handler(HTTPException)
   20:     async def http_error(request, exc):
    2:         codes = {401: "UNAUTHORIZED", 403: "FORBIDDEN", 404: "NOT_FOUND", 405: "METHOD_NOT_ALLOWED", 429: "RATE_LIMITED"}
    2:         code = codes.get(exc.status_code, "HTTP_ERROR")
    2:         request.state.error_code = code
    2:         return error_response(request.state.request_id, exc.status_code, code, code.replace("_", " ").capitalize(), headers=exc.headers)
