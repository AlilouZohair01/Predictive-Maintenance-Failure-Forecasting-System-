    1: """Causal FD001 anomaly scoring. Failure labels never enter these functions."""
    1: import numpy as np
    1: import pandas as pd
    1: from sklearn.metrics import precision_score, recall_score, f1_score, average_precision_score
       
    1: ALGORITHMS = ('isolation_forest', 'autoencoder', 'zscore')
       
       
    1: def validate_frame(frame, sensors):
   16:     frame = frame.sort_values(['unit_number', 'time_in_cycles']).reset_index(drop=True).copy()
   16:     if frame.duplicated(['unit_number', 'time_in_cycles']).any():
>>>>>>         raise ValueError('Duplicate engine/cycle observations')
   16:     if not np.isfinite(frame[sensors].to_numpy()).all():
>>>>>>         raise ValueError('Sensor values must be finite')
   31:     for _, group in frame.groupby('unit_number'):
   16:         if not np.all(np.diff(group.time_in_cycles) == 1):
    1:             raise ValueError('Cycles must be consecutive within an engine')
