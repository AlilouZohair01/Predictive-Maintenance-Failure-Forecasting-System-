    1: def consecutive(readings, start=None):
 1882:     cycles = [r.cycle for r in readings]
   33:     if start is not None and cycles[0] != start:
    2:         raise ValueError(f"History must start at cycle {start}")
 1619:     if any(b != a + 1 for a, b in zip(cycles, cycles[1:])):
    3:         raise ValueError("Cycles must be ordered, unique and consecutive")
       
       
