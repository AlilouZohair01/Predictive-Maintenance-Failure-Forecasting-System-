   15: SENSORS = [f"s_{i}" for i in (2, 3, 4, 7, 8, 11, 12, 13, 14, 15, 17, 20, 21)]
    1: Number = Annotated[float, Field(strict=True, allow_inf_nan=False)]
    1: PositiveInt = Annotated[int, Field(strict=True, gt=0)]
       
       
